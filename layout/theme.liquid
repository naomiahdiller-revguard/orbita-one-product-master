<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_ink }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <title>{% if page_title != blank %}{{ page_title }} · {% endif %}{{ shop.name }}</title>
    {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
    {{ content_for_header }}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    <style>:root{--ink:{{ settings.color_ink }};--surface:{{ settings.color_surface }};--paper:{{ settings.color_paper }};--text:{{ settings.color_text }};--muted:{{ settings.color_muted }};--accent:{{ settings.color_accent }};--accent-2:{{ settings.color_accent_2 }};--radius:{{ settings.radius }}px;--button-radius:{{ settings.button_radius }}px}</style>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </head>
  <body class="template-{{ template.name | handle }} theme-{{ settings.visual_style }}">
    <a class="skip-link" href="#MainContent">Skip to content</a>
    {% section 'announcement-bar' %}
    {% section 'site-header' %}
    <main id="MainContent" role="main">{{ content_for_layout }}</main>
    {% section 'site-footer' %}
  </body>
</html>
