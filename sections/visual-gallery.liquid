<section class="section section--surface"><div class="page-width"><div class="center" data-reveal><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2 class="heading">{{ section.settings.heading }}</h2><div class="subheading rte">{{ section.settings.copy }}</div></div><div class="gallery-grid">{% for block in section.blocks %}<figure class="{% if block.settings.crop %}crop{% endif %}" data-reveal {{ block.shopify_attributes }}>{% if block.settings.image %}{{ block.settings.image | image_url: width: 1000 | image_tag: widths: '360,600,800,1000', sizes: '(max-width: 820px) 50vw, 33vw', loading: 'lazy', alt: block.settings.alt }}{% else %}{{ 'product-' | append: forloop.index | placeholder_svg_tag }}{% endif %}{% if block.settings.caption != blank %}<figcaption>{{ block.settings.caption }}</figcaption>{% endif %}</figure>{% endfor %}</div></div></section>
{% schema %}{"name":"Visual proof gallery","max_blocks":9,"settings":[{"type":"text","id":"eyebrow","label":"Small heading","default":"Look closer"},{"type":"inline_richtext","id":"heading","label":"Heading","default":"Show every reason to believe it."},{"type":"richtext","id":"copy","label":"Copy","default":"<p>Use real close-ups, scale, packaging, use and texture photos.</p>"}],"blocks":[{"type":"image","name":"Gallery image","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"alt","label":"Image description"},{"type":"text","id":"caption","label":"Optional caption","default":"What this image proves"},{"type":"checkbox","id":"crop","label":"Crop square instead of showing full image","default":false}]}],"presets":[{"name":"Visual proof gallery","blocks":[{"type":"image"},{"type":"image"},{"type":"image"},{"type":"image"},{"type":"image"},{"type":"image"}]}]}{% endschema %}
