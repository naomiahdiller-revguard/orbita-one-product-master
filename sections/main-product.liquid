{% liquid
  assign featured_product = section.settings.product
  if product != blank
    assign featured_product = product
  endif
  if featured_product == blank
    assign featured_product = collections.all.products.first
  endif
%}
<section class="section" id="shop"><div class="page-width product-layout"><div class="product-gallery" data-gallery data-reveal>{% if featured_product != blank and featured_product.featured_image %}<div class="product-main"><img data-gallery-main src="{{ featured_product.featured_image | image_url: width: 1400 }}" srcset="{{ featured_product.featured_image | image_url: width: 600 }} 600w, {{ featured_product.featured_image | image_url: width: 1000 }} 1000w, {{ featured_product.featured_image | image_url: width: 1400 }} 1400w" sizes="(max-width: 820px) 100vw, 54vw" width="{{ featured_product.featured_image.width }}" height="{{ featured_product.featured_image.height }}" alt="{{ featured_product.featured_image.alt | default: featured_product.title | escape }}"></div><div class="thumbs">{% for media in featured_product.media limit: 5 %}{% if media.preview_image %}<button class="thumb{% if forloop.first %} is-active{% endif %}" type="button" data-gallery-thumb data-src="{{ media.preview_image | image_url: width: 1400 }}"><img src="{{ media.preview_image | image_url: width: 220 }}" width="{{ media.preview_image.width }}" height="{{ media.preview_image.height }}" alt="{{ media.preview_image.alt | default: featured_product.title | escape }}" loading="lazy"></button>{% endif %}{% endfor %}</div>{% else %}<div class="product-main">{{ 'product-1' | placeholder_svg_tag }}</div>{% endif %}</div><div data-buy-box data-reveal><p class="eyebrow">{{ section.settings.eyebrow }}</p><h{% if product != blank %}1{% else %}2{% endif %} class="product-title">{{ featured_product.title | default: section.settings.placeholder_title }}</h{% if product != blank %}1{% else %}2{% endif %}>{% if featured_product != blank %}<div class="price">{{ featured_product.price | money }}{% if featured_product.compare_at_price > featured_product.price %}<span class="compare-price">{{ featured_product.compare_at_price | money }}</span>{% endif %}</div>{% endif %}<div class="product-description rte">{% if section.settings.custom_description != blank %}{{ section.settings.custom_description }}{% elsif featured_product.description != blank %}{{ featured_product.description }}{% else %}<p>{{ section.settings.placeholder_description }}</p>{% endif %}</div>{% if featured_product != blank %}{% form 'product', featured_product, class: 'product-form' %}{% unless featured_product.has_only_default_variant %}<label class="form-label" for="Variant-{{ section.id }}">{{ section.settings.variant_label }}</label><select class="variant-select" id="Variant-{{ section.id }}" name="id">{% for variant in featured_product.variants %}<option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}>{{ variant.title }}{% unless variant.available %} — Sold out{% endunless %}</option>{% endfor %}</select>{% else %}<input type="hidden" name="id" value="{{ featured_product.selected_or_first_available_variant.id }}">{% endunless %}<label class="form-label" for="Quantity-{{ section.id }}">Quantity</label><input class="quantity" id="Quantity-{{ section.id }}" name="quantity" type="number" value="1" min="1"><button class="button button--accent button--wide" type="submit" name="add" data-main-atc {% unless featured_product.available %}disabled{% endunless %}>{% if featured_product.available %}{{ section.settings.button_label }} · {{ featured_product.price | money }}{% else %}Sold out{% endif %}</button>{% if section.settings.dynamic_checkout %}{{ form | payment_button }}{% endif %}{% endform %}{% else %}<div class="button button--wide">Select a product in Shopify Customize</div>{% endif %}<div class="buy-trust">{% for block in section.blocks %}{% if block.type == 'trust' %}<div {{ block.shopify_attributes }}>{{ block.settings.text }}</div>{% endif %}{% endfor %}</div><div class="details">{% for block in section.blocks %}{% if block.type == 'detail' %}<details {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}><summary>{{ block.settings.heading }}</summary><div class="rte">{{ block.settings.content }}</div></details>{% endif %}{% endfor %}</div></div></div></section>{% if featured_product != blank and section.settings.sticky_button %}<div class="sticky-atc" data-sticky-atc><div><strong>{{ featured_product.title }}</strong><br><small>{{ featured_product.price | money }}</small></div><button class="button" type="button">{{ section.settings.mobile_button }}</button></div>{% endif %}
{% schema %}{"name":"Main product and buy box","max_blocks":10,"settings":[{"type":"product","id":"product","label":"Featured product","info":"Choose this on the homepage. Product pages use the current product automatically."},{"type":"text","id":"eyebrow","label":"Small heading","default":"The product everyone asks about"},{"type":"text","id":"placeholder_title","label":"Placeholder title","default":"Your Winning Product"},{"type":"textarea","id":"placeholder_description","label":"Placeholder description","default":"Choose your Shopify product above. Its title, price, images, variants and description will connect automatically."},{"type":"richtext","id":"custom_description","label":"Optional custom sales description","info":"Leave blank to use the Shopify product description."},{"type":"text","id":"variant_label","label":"Variant label","default":"Choose your style"},{"type":"text","id":"button_label","label":"Add-to-cart button","default":"Add to bag"},{"type":"checkbox","id":"dynamic_checkout","label":"Show accelerated checkout button","default":true},{"type":"checkbox","id":"sticky_button","label":"Show sticky mobile purchase bar","default":true},{"type":"text","id":"mobile_button","label":"Sticky mobile button","default":"Get yours"}],"blocks":[{"type":"trust","name":"Buy-box trust point","settings":[{"type":"text","id":"text","label":"Text","default":"Secure checkout"}]},{"type":"detail","name":"Expandable detail","settings":[{"type":"text","id":"heading","label":"Heading","default":"Product details"},{"type":"richtext","id":"content","label":"Content","default":"<p>Add verified specifications and material details here.</p>"},{"type":"checkbox","id":"open","label":"Open by default","default":false}]}],"presets":[{"name":"Main product and buy box","blocks":[{"type":"trust","settings":{"text":"Secure checkout"}},{"type":"trust","settings":{"text":"Tracked delivery"}},{"type":"trust","settings":{"text":"Carefully packed"}},{"type":"detail","settings":{"heading":"Product details","open":true}},{"type":"detail","settings":{"heading":"Shipping and returns"}},{"type":"detail","settings":{"heading":"Care and safety"}}]}]}{% endschema %}
