<section class="proof-bar"><div class="page-width proof-grid">{% for block in section.blocks %}<div class="proof-item" {{ block.shopify_attributes }}><strong>{{ block.settings.heading }}</strong><span>{{ block.settings.text }}</span></div>{% endfor %}</div></section>
{% schema %}{"name":"Proof bar","max_blocks":4,"settings":[],"blocks":[{"type":"proof","name":"Proof point","settings":[{"type":"text","id":"heading","label":"Heading","default":"Easy to understand"},{"type":"text","id":"text","label":"Supporting text","default":"Show the value in seconds"}]}],"presets":[{"name":"Proof bar","blocks":[{"type":"proof","settings":{"heading":"See it instantly","text":"Visual demonstration first"}},{"type":"proof","settings":{"heading":"Built to share","text":"Made for satisfying content"}},{"type":"proof","settings":{"heading":"Easy to gift","text":"A delightful little find"}},{"type":"proof","settings":{"heading":"Shop safely","text":"Secure Shopify checkout"}}]}]}{% endschema %}
