<section class="section section--surface" id="faq"><div class="page-width"><div class="center" data-reveal><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2 class="heading">{{ section.settings.heading }}</h2><div class="subheading rte">{{ section.settings.copy }}</div></div><div class="faq">{% for block in section.blocks %}<details {{ block.shopify_attributes }}><summary>{{ block.settings.question }}</summary><div class="answer rte">{{ block.settings.answer }}</div></details>{% endfor %}</div></div></section>
{% schema %}{"name":"FAQ","max_blocks":12,"settings":[{"type":"text","id":"eyebrow","label":"Small heading","default":"Good to know"},{"type":"inline_richtext","id":"heading","label":"Heading","default":"Questions, answered."},{"type":"richtext","id":"copy","label":"Copy","default":"<p>Remove the final reasons someone may hesitate to purchase.</p>"}],"blocks":[{"type":"question","name":"Question","settings":[{"type":"text","id":"question","label":"Question","default":"What does it feel like?"},{"type":"richtext","id":"answer","label":"Answer","default":"<p>Give a direct, factual and reassuring answer.</p>"}]}],"presets":[{"name":"FAQ","blocks":[{"type":"question"},{"type":"question"},{"type":"question"},{"type":"question"},{"type":"question"}]}]}{% endschema %}
