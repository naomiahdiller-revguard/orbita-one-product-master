<section class="section section--surface"><div class="page-width"><div class="center" data-reveal><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2 class="heading">{{ section.settings.heading }}</h2></div><div class="comparison" data-reveal><div><h3>{{ section.settings.left_heading }}</h3><ul>{% for block in section.blocks %}{% if block.type == 'left' %}<li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>{% endif %}{% endfor %}</ul></div><div><h3>{{ section.settings.right_heading }}</h3><ul>{% for block in section.blocks %}{% if block.type == 'right' %}<li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>{% endif %}{% endfor %}</ul></div></div></div></section>
{% schema %}{"name":"Problem and comparison","max_blocks":10,"settings":[{"type":"text","id":"eyebrow","label":"Small heading","default":"Why this one"},{"type":"inline_richtext","id":"heading","label":"Heading","default":"Not another forgettable impulse buy."},{"type":"text","id":"left_heading","label":"Left column heading","default":"The usual version"},{"type":"text","id":"right_heading","label":"Right column heading","default":"Your product"}],"blocks":[{"type":"left","name":"Left comparison point","settings":[{"type":"text","id":"text","label":"Text","default":"A common customer frustration"}]},{"type":"right","name":"Right comparison point","settings":[{"type":"text","id":"text","label":"Text","default":"Your verified advantage"}]}],"presets":[{"name":"Problem and comparison","blocks":[{"type":"left"},{"type":"left"},{"type":"left"},{"type":"right"},{"type":"right"},{"type":"right"}]}]}{% endschema %}
