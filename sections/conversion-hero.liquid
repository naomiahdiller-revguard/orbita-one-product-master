<section class="hero"><div class="page-width hero-grid"><div data-reveal><p class="eyebrow">{{ section.settings.eyebrow }}</p><h1 class="hero-title">{{ section.settings.heading }}</h1><div class="hero-copy rte">{{ section.settings.copy }}</div><div class="hero-actions"><a class="button button--accent" href="{{ section.settings.primary_link | default: '#shop' }}">{{ section.settings.primary_label }}</a>{% if section.settings.secondary_label != blank %}<a class="button button--outline" href="{{ section.settings.secondary_link | default: '#demo' }}">{{ section.settings.secondary_label }}</a>{% endif %}</div><div class="micro-row">{% for block in section.blocks %}<span {{ block.shopify_attributes }}>{{ block.settings.text }}</span>{% endfor %}</div></div><div class="hero-media hero-media--{{ section.settings.media_ratio }}" data-reveal>{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1600 | image_tag: widths: '480,720,960,1200,1600', sizes: '(max-width: 820px) 90vw, 52vw', loading: 'eager', fetchpriority: 'high', alt: section.settings.image_alt }}{% else %}{{ 'product-1' | placeholder_svg_tag }}{% endif %}{% if section.settings.media_note != blank %}<span class="hero-card">{{ section.settings.media_note }}</span>{% endif %}</div></div></section>
{% schema %}{"name":"Conversion hero","max_blocks":4,"settings":[{"type":"text","id":"eyebrow","label":"Small heading","default":"Meet your new favorite find"},{"type":"inline_richtext","id":"heading","label":"Main headline","default":"The product your feed cannot stop watching."},{"type":"richtext","id":"copy","label":"Supporting copy","default":"<p>Lead with the clearest reason this product is exciting, useful, satisfying or giftable.</p>"},{"type":"text","id":"primary_label","label":"Primary button","default":"Get yours"},{"type":"url","id":"primary_link","label":"Primary button link"},{"type":"text","id":"secondary_label","label":"Secondary button","default":"See it in action"},{"type":"url","id":"secondary_link","label":"Secondary button link"},{"type":"image_picker","id":"image","label":"Hero product image"},{"type":"text","id":"image_alt","label":"Image description","default":"Featured product"},{"type":"select","id":"media_ratio","label":"Image shape — never stretched","default":"square","options":[{"value":"square","label":"Square, show full image"},{"value":"portrait","label":"Portrait, show full image"},{"value":"landscape","label":"Landscape, show full image"}]},{"type":"text","id":"media_note","label":"Small image note","default":"Made to stop the scroll"}],"blocks":[{"type":"micro_proof","name":"Micro proof point","settings":[{"type":"text","id":"text","label":"Text","default":"Secure checkout"}]}],"presets":[{"name":"Conversion hero","blocks":[{"type":"micro_proof","settings":{"text":"Visual proof first"}},{"type":"micro_proof","settings":{"text":"Giftable find"}},{"type":"micro_proof","settings":{"text":"Secure checkout"}}]}]}{% endschema %}
