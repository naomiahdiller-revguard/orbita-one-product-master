<section class="section"><div class="page-width"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h1 class="heading">{{ section.settings.heading }}</h1>{% if cart.item_count > 0 %}<form action="{{ routes.cart_url }}" method="post">{% for item in cart.items %}<div class="cart-item">{% if item.image %}<a href="{{ item.url }}">{{ item.image | image_url: width: 220 | image_tag: loading: 'lazy', alt: item.title }}</a>{% endif %}<div><a href="{{ item.url }}"><strong>{{ item.product.title }}</strong></a><p>{{ item.variant.title }}</p><label for="updates_{{ item.key }}">Quantity</label> <input class="quantity" id="updates_{{ item.key }}" name="updates[]" value="{{ item.quantity }}" min="0" type="number"></div><div>{{ item.final_line_price | money }}</div></div>{% endfor %}<div class="cart-total"><p>Subtotal <strong>{{ cart.total_price | money }}</strong></p><p><small>{{ section.settings.checkout_note }}</small></p><button class="button button--outline" type="submit" name="update">Update bag</button> <button class="button button--accent" type="submit" name="checkout">Checkout</button></div></form>{% else %}<div class="empty"><p>{{ section.settings.empty_text }}</p><a class="button" href="{{ routes.root_url }}#shop">{{ section.settings.empty_button }}</a></div>{% endif %}</div></section>
{% schema %}{"name":"Cart","settings":[{"type":"text","id":"eyebrow","label":"Small heading","default":"Your bag"},{"type":"text","id":"heading","label":"Heading","default":"You are almost there."},{"type":"text","id":"checkout_note","label":"Checkout note","default":"Shipping and taxes calculated at checkout."},{"type":"text","id":"empty_text","label":"Empty cart text","default":"Your bag is waiting for something fun."},{"type":"text","id":"empty_button","label":"Empty cart button","default":"Return to the product"}]}{% endschema %}
