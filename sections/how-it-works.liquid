<section class="section"><div class="page-width"><div class="center" data-reveal><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2 class="heading">{{ section.settings.heading }}</h2><div class="subheading rte">{{ section.settings.copy }}</div></div><div class="steps">{% for block in section.blocks %}<article class="step" data-reveal {{ block.shopify_attributes }}><div class="step-index">0{{ forloop.index }}</div><h3>{{ block.settings.heading }}</h3><p>{{ block.settings.text }}</p></article>{% endfor %}</div></div></section>
{% schema %}{"name":"How it works","max_blocks":4,"settings":[{"type":"text","id":"eyebrow","label":"Small heading","default":"Simple by design"},{"type":"inline_richtext","id":"heading","label":"Heading","default":"How it works"},{"type":"richtext","id":"copy","label":"Copy","default":"<p>Make the product feel effortless and immediately understandable.</p>"}],"blocks":[{"type":"step","name":"Step","settings":[{"type":"text","id":"heading","label":"Heading","default":"Open it"},{"type":"textarea","id":"text","label":"Explanation","default":"Explain this step in one quick sentence."}]}],"presets":[{"name":"How it works","blocks":[{"type":"step"},{"type":"step"},{"type":"step"}]}]}{% endschema %}
