{% if section.settings.show %}<div class="announcement">{% if section.settings.link != blank %}<a href="{{ section.settings.link }}">{% endif %}{{ section.settings.text }}{% if section.settings.link != blank %}</a>{% endif %}</div>{% endif %}
{% schema %}{"name":"Announcement bar","settings":[{"type":"checkbox","id":"show","label":"Show announcement","default":true},{"type":"text","id":"text","label":"Announcement text","default":"Free shipping on orders over $40"},{"type":"url","id":"link","label":"Optional link"}]}{% endschema %}
