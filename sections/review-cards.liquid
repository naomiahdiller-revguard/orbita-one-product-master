{% if section.settings.show %}<section class="section"><div class="page-width"><div class="center" data-reveal><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2 class="heading">{{ section.settings.heading }}</h2><p class="subheading">{{ section.settings.note }}</p></div><div class="reviews">{% for block in section.blocks %}<article class="review" data-reveal {{ block.shopify_attributes }}><div class="stars" aria-label="{{ block.settings.rating }} out of 5 stars">{% for i in (1..5) %}{% if i <= block.settings.rating %}★{% else %}☆{% endif %}{% endfor %}</div><p>“{{ block.settings.quote }}”</p><strong>{{ block.settings.name }}</strong><br><small>{{ block.settings.context }}</small></article>{% endfor %}</div></div></section>{% endif %}
{% schema %}{"name":"Verified review cards","max_blocks":6,"settings":[{"type":"checkbox","id":"show","label":"Show reviews","info":"Only enable after adding genuine customer reviews.","default":false},{"type":"text","id":"eyebrow","label":"Small heading","default":"Real customer feedback"},{"type":"inline_richtext","id":"heading","label":"Heading","default":"People tried it. Here is what they said."},{"type":"text","id":"note","label":"Disclosure or note","default":"Reviews shown here should come from verified, genuine customer experiences."}],"blocks":[{"type":"review","name":"Genuine review","settings":[{"type":"range","id":"rating","label":"Rating","min":1,"max":5,"step":1,"default":5},{"type":"textarea","id":"quote","label":"Exact customer review","default":"Paste a genuine customer review here."},{"type":"text","id":"name","label":"Customer name or initials","default":"Customer"},{"type":"text","id":"context","label":"Verification context","default":"Verified customer"}]}],"presets":[{"name":"Verified review cards"}]}{% endschema %}
