<section class="section" id="benefits"><div class="page-width"><div class="center" data-reveal><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2 class="heading">{{ section.settings.heading }}</h2><div class="subheading rte">{{ section.settings.copy }}</div></div><div class="benefit-grid">{% for block in section.blocks %}<article class="benefit-card" data-reveal {{ block.shopify_attributes }}>{% if block.settings.image %}{{ block.settings.image | image_url: width: 700 | image_tag: widths: '320,480,700', loading: 'lazy', alt: block.settings.image_alt }}{% endif %}<h3>{{ block.settings.heading }}</h3><p>{{ block.settings.text }}</p></article>{% endfor %}</div></div></section>
{% schema %}{"name":"Benefit cards","max_blocks":6,"settings":[{"type":"text","id":"eyebrow","label":"Small heading","default":"Why people want it"},{"type":"inline_richtext","id":"heading","label":"Heading","default":"A simple product with irresistible reasons."},{"type":"richtext","id":"copy","label":"Copy","default":"<p>Turn features into the experiences customers actually care about.</p>"}],"blocks":[{"type":"benefit","name":"Benefit","settings":[{"type":"image_picker","id":"image","label":"Optional image"},{"type":"text","id":"image_alt","label":"Image description"},{"type":"text","id":"heading","label":"Benefit heading","default":"Satisfying to use"},{"type":"textarea","id":"text","label":"Benefit description","default":"Describe exactly what the customer sees, feels or gets."}]}],"presets":[{"name":"Benefit cards","blocks":[{"type":"benefit"},{"type":"benefit"},{"type":"benefit"}]}]}{% endschema %}
