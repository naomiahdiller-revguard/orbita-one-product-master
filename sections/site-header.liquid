<header class="site-header"><div class="page-width header-inner"><a class="brand" href="{{ routes.root_url }}" style="--logo-width:{{ settings.logo_width }}px">{% if settings.logo %}{{ settings.logo | image_url: width: 520 | image_tag: widths: '160,240,360,520', alt: settings.brand_name }}{% else %}{{ settings.brand_name }}{% endif %}</a><nav class="nav" aria-label="Main navigation">{% for block in section.blocks %}<a href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>{% endfor %}</nav><div><button class="menu-toggle" type="button" data-menu-toggle>Menu</button><a class="cart-link" href="{{ routes.cart_url }}">{{ section.settings.cart_label }} ({{ cart.item_count }})</a></div></div><nav class="mobile-nav page-width" data-mobile-nav>{% for block in section.blocks %}<a href="{{ block.settings.link }}">{{ block.settings.label }}</a>{% endfor %}</nav></header>
{% schema %}{"name":"Header","max_blocks":5,"settings":[{"type":"text","id":"cart_label","label":"Cart label","default":"Bag"}],"blocks":[{"type":"link","name":"Navigation link","settings":[{"type":"text","id":"label","label":"Label","default":"Shop"},{"type":"url","id":"link","label":"Link"}]}],"default":{"blocks":[{"type":"link","settings":{"label":"Why it works","link":"#benefits"}},{"type":"link","settings":{"label":"See it in action","link":"#demo"}},{"type":"link","settings":{"label":"FAQ","link":"#faq"}}]}}{% endschema %}
