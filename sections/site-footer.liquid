<footer class="site-footer"><div class="page-width"><div class="footer-grid"><div><a class="brand" href="{{ routes.root_url }}">{{ settings.brand_name }}</a><p>{{ section.settings.tagline }}</p></div><div><strong>{{ section.settings.menu_heading }}</strong><div class="footer-links">{% for block in section.blocks %}<a href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>{% endfor %}</div></div><div><strong>{{ section.settings.policy_heading }}</strong><div class="footer-links">{% for policy in shop.policies %}{% if policy != blank %}<a href="{{ policy.url }}">{{ policy.title }}</a>{% endif %}{% endfor %}{% if shop.email != blank %}<a href="mailto:{{ shop.email }}">Contact</a>{% endif %}</div></div></div><div class="footer-bottom">© {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.copyright }}</div></div></footer>
{% schema %}{"name":"Footer","max_blocks":6,"settings":[{"type":"text","id":"tagline","label":"Brand tagline","default":"Small finds that make ordinary moments more fun."},{"type":"text","id":"menu_heading","label":"Menu heading","default":"Explore"},{"type":"text","id":"policy_heading","label":"Policy heading","default":"Information"},{"type":"text","id":"copyright","label":"Copyright ending","default":"All rights reserved."}],"blocks":[{"type":"link","name":"Footer link","settings":[{"type":"text","id":"label","label":"Label","default":"Shop"},{"type":"url","id":"link","label":"Link"}]}],"default":{"blocks":[{"type":"link","settings":{"label":"Shop","link":"#shop"}},{"type":"link","settings":{"label":"FAQ","link":"#faq"}},{"type":"link","settings":{"label":"Your bag","link":"/cart"}}]}}{% endschema %}
