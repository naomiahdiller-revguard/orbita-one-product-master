<section class="section section--surface" id="demo"><div class="page-width split"><div class="media-frame media-frame--{{ section.settings.media_ratio }}{% if section.settings.crop_media %} media-frame--crop{% endif %}" data-reveal>{% if section.settings.video != blank %}{{ section.settings.video | video_tag: autoplay: section.settings.autoplay, loop: true, muted: true, controls: false, playsinline: true, image_size: '1000x' }}{% elsif section.settings.image != blank %}{{ section.settings.image | image_url: width: 1400 | image_tag: widths: '480,720,1000,1400', sizes: '(max-width: 820px) 100vw, 50vw', loading: 'lazy', alt: section.settings.image_alt }}{% else %}{{ 'lifestyle-1' | placeholder_svg_tag }}{% endif %}{% if section.settings.video != blank and section.settings.sound_button %}<button class="sound-button" type="button" data-video-sound>Turn sound on</button>{% endif %}</div><div data-reveal><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2 class="heading">{{ section.settings.heading }}</h2><div class="subheading rte">{{ section.settings.copy }}</div><div class="feature-stack">{% for block in section.blocks %}<div class="feature-line" {{ block.shopify_attributes }}><span class="feature-number">{{ forloop.index }}</span><div><strong>{{ block.settings.heading }}</strong><p>{{ block.settings.text }}</p></div></div>{% endfor %}</div>{% if section.settings.button_label != blank %}<button class="button" type="button" data-scroll-buy>{{ section.settings.button_label }}</button>{% endif %}</div></div></section>
{% schema %}{"name":"Video or image story","max_blocks":5,"settings":[{"type":"text","id":"eyebrow","label":"Small heading","default":"See it in action"},{"type":"inline_richtext","id":"heading","label":"Heading","default":"Show the moment that makes people want it."},{"type":"richtext","id":"copy","label":"Copy","default":"<p>Use real movement, texture or transformation to prove why the product is satisfying and different.</p>"},{"type":"video","id":"video","label":"Shopify-hosted video"},{"type":"image_picker","id":"image","label":"Fallback image"},{"type":"text","id":"image_alt","label":"Image description","default":"Product demonstration"},{"type":"select","id":"media_ratio","label":"Media shape","default":"portrait","options":[{"value":"portrait","label":"Portrait 4:5"},{"value":"square","label":"Square 1:1"},{"value":"landscape","label":"Landscape 16:10"}]},{"type":"checkbox","id":"crop_media","label":"Crop to fill frame instead of showing full image","default":false},{"type":"checkbox","id":"autoplay","label":"Autoplay muted video","default":true},{"type":"checkbox","id":"sound_button","label":"Show sound toggle","default":true},{"type":"text","id":"button_label","label":"Button text","default":"Shop now"}],"blocks":[{"type":"point","name":"Story point","settings":[{"type":"text","id":"heading","label":"Heading","default":"A benefit people can see"},{"type":"textarea","id":"text","label":"Explanation","default":"Explain the product in one clear, believable sentence."}]}],"presets":[{"name":"Video or image story","blocks":[{"type":"point"},{"type":"point"},{"type":"point"}]}]}{% endschema %}
